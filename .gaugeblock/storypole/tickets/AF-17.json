        "decision_id": "2492020d-b401-4b4f-af61-3bc881c15515",
        "parent_decision_id": null,
        "status": "resolved",
        "category": "architecture",
        "question": "Which concurrency model does aerofoil-tracker use? Decided by ADR-0005; flip the record to Accepted in the same commit as the decision.",
        "proposed_options": [
          "striped parking_lot::RwLock shards",
          "lock-free map with epoch reclamation",
          "single-writer actor with arc-swap snapshots",
          "per-field atomics over a seqlock"
        ],
        "chosen_option": "striped parking_lot::RwLock shards",
        "rationale": "Zero-allocation read path for AddressFilter hot path, 64-way partitioned write concurrency without cross-aircraft contention, pure safe Rust without seqlock tearing risks or copy-on-write allocation overhead, decoupled from asynchronous frame recording sink (ADR-0009).",
        "resolved_by": "user",
        "updated_at_epoch_ms": 1794289275938
